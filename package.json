{
  "name": "docker-terminal",
  "displayName": "Docker Terminal",
  "description": "Open a terminal into a docker-compose service using the container's default login shell.",
  "version": "0.1.0",
  "publisher": "codemastersolutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codemastersolutions/docker-terminal.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "docker",
    "docker-compose",
    "terminal",
    "shell"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/docker-compose.{yml,yaml}",
    "workspaceContains:**/compose.{yml,yaml}",
    "workspaceContains:**/docker-compose.yml",
    "workspaceContains:**/docker-compose.yaml",
    "workspaceContains:**/compose.yml",
    "workspaceContains:**/compose.yaml"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "compose.openShell",
        "title": "Open Shell in Service",
        "category": "Docker Terminal"
      }
    ],
    "keybindings": [
      {
        "command": "compose.openShell",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Docker Terminal",
      "properties": {
        "composeTerminal.dockerCommand": {
          "type": "string",
          "default": "docker",
          "description": "Path or name of the docker CLI."
        },
        "composeTerminal.preferComposeV2": {
          "type": "boolean",
          "default": true,
          "description": "Use 'docker compose' (v2) before falling back to 'docker-compose' (v1)."
        },
        "composeTerminal.composeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Explicit compose file paths. Empty = auto-detect in workspace roots."
        },
        "composeTerminal.terminalName": {
          "type": "string",
          "default": "{service} • {project}",
          "description": "Pattern for terminal name. Placeholders: {service}, {project}."
        },
        "composeTerminal.clearOnExit": {
          "type": "boolean",
          "default": true,
          "description": "Bracket the `docker compose exec` call with a host-shell cleanup command — one before attach, one after exit — so the VS Code terminal is cleared before you enter and after you leave the container. Uses `clear` on Linux/macOS and `cls` on Windows."
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist docker-terminal*.vsix",
    "prebuild": "npm run clean && npm run typecheck && npm run test",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package",
    "test:unit": "tsx test/parser.smoke.ts && tsx test/sanitize.smoke.ts && tsx test/argv.smoke.ts && tsx test/validation.smoke.ts && tsx test/clearCommand.smoke.ts",
    "test:integration": "tsx test/compose-cli.smoke.ts",
    "test:e2e": "tsx test/e2e.smoke.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "release:version": "node scripts/bump-version.js",
    "commitzero": "commitzero",
    "commitzero:install": "npm exec commitzero install-hooks",
    "commitzero:uninstall": "npm exec commitzero uninstall-hooks",
    "commit": "npm run commitzero -- commit --add",
    "commit:push": "npm run commitzero -- commit --add --push"
  },
  "dependencies": {
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@codemastersolutions/commitzero": "^0.0.53",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vsce": "^2.15.0"
  },
  "overrides": {
    "markdown-it": "^14.1.2",
    "xml2js": "^0.5.0",
    "linkify-it": "^5.0.2"
  },
  "allowScripts": {
    "@codemastersolutions/commitzero@0.0.53": true
  }
}
